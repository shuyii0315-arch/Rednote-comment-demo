{
  "$meta": {
    "name": "评论区互动 · 组件库 tokens",
    "source": "从 Rednote-comment-demo 原型（screens.js + index.html）逐项抽取后归并",
    "unit": "pt，按 375 宽手机换算（原型 Figma 画板宽 260，换算系数 375/260 ≈ 1.442）",
    "note": "原型本身没有改动；这里是归并后的规范值。原型里每个原始值对应到哪个 token，见 audit/mapping.md"
  },
  "color": {
    "brand": {
      "red":      { "value": "#FF2442", "use": "点赞、关注、作者标、主操作" },
      "redWeak":  { "value": "#FFECF0", "use": "红色浅底：选中的筛选胶囊、轻提示底" }
    },
    "text": {
      "strong":    { "value": "#222222", "use": "笔记标题、选中的 Tab / 筛选项" },
      "primary":   { "value": "#333333", "use": "评论正文、用户名" },
      "secondary": { "value": "#666666", "use": "回复、计数" },
      "tertiary":  { "value": "#8C8C8C", "use": "筛选项、查看 ›、次要说明" },
      "meta":      { "value": "#AEA7A7", "use": "时间与地点、输入框占位" },
      "weak":      { "value": "#999999", "use": "「N 人晒过」这类弱计数" },
      "disabled":  { "value": "#B2B2B2", "use": "日期、到底了" },
      "inverse":   { "value": "#FFFFFF", "use": "深色底上的文字" }
    },
    "surface": {
      "page":     { "value": "#FFFFFF", "use": "页面底色" },
      "subtle":   { "value": "#F5F5F5", "use": "输入框、灰底卡片" },
      "pressed":  { "value": "#EFEFEF", "use": "列表行按下" },
      "flash":    { "value": "#F2F2F2", "use": "定位到某条评论时的闪烁底" }
    },
    "line": {
      "divider":  { "value": "#EEEEEE", "use": "分隔线" },
      "border":   { "value": "#E0E0E0", "use": "胶囊、输入框描边" },
      "strong":   { "value": "#CCCCCC", "use": "未选中的圆点、强描边" }
    },
    "badge": {
      "classRepBg":   { "value": "#FFF3C4", "use": "课代表标签底" },
      "classRepText": { "value": "#7A5C00", "use": "课代表标签字" },
      "waiting":      { "value": "#B07A00", "use": "「N 人在蹲」" }
    },
    "ai": {
      "bg":   { "value": "#EAF1FF", "use": "@点点 胶囊底" },
      "text": { "value": "#24427D", "use": "@点点 胶囊字" },
      "link": { "value": "#295294", "use": "搜索联想等链接色" }
    },
    "overlay": {
      "scrim": { "value": "rgba(0,0,0,0.40)", "use": "底部弹层背后的遮罩" },
      "pill":  { "value": "rgba(0,0,0,0.45)", "use": "图片上的问答胶囊" },
      "toast": { "value": "rgba(0,0,0,0.78)", "use": "Toast" }
    },
    "focus": { "value": "#3478F6", "use": "键盘焦点框" }
  },
  "typography": {
    "family": {
      "zh":  { "value": "\"Noto Sans SC\", \"PingFang SC\", -apple-system, sans-serif" },
      "num": { "value": "Inter, -apple-system, sans-serif", "use": "状态栏时间等数字" }
    },
    "size": {
      "tag":   { "value": 8,  "use": "课代表标签" },
      "micro": { "value": 10, "use": "日期、作者标" },
      "caption": { "value": 11, "use": "「N 人晒过」、筛选胶囊" },
      "meta":  { "value": 12, "use": "时间地点、回复、计数" },
      "body":  { "value": 13, "use": "评论正文" },
      "title": { "value": 14, "use": "列表标题、按钮" },
      "headline": { "value": 15, "use": "用户名（加粗）、页面标题" }
    },
    "weight": { "regular": 400, "medium": 500, "bold": 700 },
    "lineHeight": { "tight": 1.3, "body": 1.5 }
  },
  "radius": {
    "xs": { "value": 3,   "use": "课代表标签" },
    "sm": { "value": 6,   "use": "评论里的小图" },
    "md": { "value": 8,   "use": "晒图、卡片（原型里最常用）" },
    "lg": { "value": 12,  "use": "弹层内卡片" },
    "xl": { "value": 16,  "use": "底部弹层顶部、通知横幅" },
    "full": { "value": 999, "use": "胶囊、头像" }
  },
  "space": {
    "$note": "原型是绝对定位，没有统一的间距值；这里按 4pt 网格给出规范，后续新页面按此执行",
    "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32
  },
  "elevation": {
    "hairline": { "value": "0 1px 0 rgba(0,0,0,0.12)", "use": "评论区顶部细线阴影" },
    "card":     { "value": "0 12px 36px rgba(0,0,0,0.08)", "use": "浮起的卡片" },
    "float":    { "value": "0 6px 24px rgba(0,0,0,0.12), 0 0 0 0.5px rgba(0,0,0,0.04)", "use": "通知横幅" }
  },
  "motion": {
    "easing": {
      "standard":  { "value": "cubic-bezier(.32,.72,0,1)",  "use": "位移类：返回、通知下落、评论让位、问答胶囊展开、关注出现" },
      "enter":     { "value": "cubic-bezier(.2,.8,.2,1)",   "use": "出现类：底部弹层上滑、页面推入、表情面板展开" },
      "exit":      { "value": "cubic-bezier(.4,0,1,1)",     "use": "离开类：收起、退出" },
      "overshoot": { "value": "cubic-bezier(.34,1.56,.64,1)", "use": "表情图标弹出、悬停放大" },
      "heartbeat": { "value": "cubic-bezier(.2,.7,.3,1)",   "use": "点赞心跳" },
      "burst":     { "value": "cubic-bezier(.25,.6,.35,1)", "use": "点赞光圈、火花" },
      "fade":      { "value": "ease-out",                   "use": "纯透明度变化" }
    },
    "duration": {
      "press":    { "value": 100, "use": "按下缩放" },
      "quick":    { "value": 160, "use": "表情面板收起、图标按压" },
      "fast":     { "value": 200, "use": "表情面板展开、Toast、新评论淡入" },
      "base":     { "value": 300, "use": "淡入、页面推入、问答胶囊展开" },
      "moderate": { "value": 340, "use": "底部弹层上滑、评论让位、表情图标弹出" },
      "slow":     { "value": 420, "use": "通知下落、点赞心跳" },
      "emphasis": { "value": 500, "use": "点赞光圈" }
    },
    "press": { "scale": 0.97, "use": "可点元素按下统一缩到 97%" }
  }
}
